{
  "name": "polizei",
  "version": "0.1.7",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "sequelize:generate": "sequelize-cli migration:generate --name",
    "sequelize:migrate": "sequelize-cli db:migrate",
    "sequelize:migrate:all": "sequelize-cli db:migrate:all",
    "sequelize:undo": "sequelize-cli db:migrate:undo:all --to",
    "sequelize:generate:seed": "sequelize-cli seed:generate --name",
    "sequelize:migrate:seed": "sequelize-cli db:seed:all",
    "migrate": "ts-node scripts/schemas.ts",
    "docker:start": "npm run migrate && npm run start:prod"
  },
