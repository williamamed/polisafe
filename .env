
NODE_ENV="development"

# DB
HOST="localhost"
DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_PASS="postgres"
DB_DIALECT="postgres"
DB_NAME="polisafe"

# WEB SERVER
PORT=3000
APP_PREFIX="/api/v4/security"

# deprecated
BACKBONE_SUBSCRIBE="http://localhost:3005/api/v3.3/backbone/events/subscribe"
BACKBONE_PUBLISH="http://localhost:3005/api/v3.3/backbone/events/publish"
BACKBONE_ENDPOINT="http://localhost:3000/api/v4/security/backbone/endpoint"
BACKBONE_NAME="polizei:service"

# NEW OAUTH
PSL_JWT_REFRESH_EXPIRES_IN="1h"
PLS_JWT_ACCESS_EXPIRES_IN="15m"
PLS_ORIGIN_COOKIE_SECRET="abc"
PLS_PUBLIC_URL="http://localhost:3000"
# remote|token
PLS_PERMISSION_CHECK=""

# SCHEMAS
SCHEMAS="security,oauth"

# UI
PLS_UI_OAUTH_SCOPE="openid profile"
PLS_UI_MODE=""
PLS_UI_IA_CHAT=""