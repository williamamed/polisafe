<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Iniciar sesión — Example OAuth</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center">
  <main class="w-full max-w-md p-6 bg-white rounded-2xl shadow-md ml-4 mr-4">
    <header class="text-center mb-6">
      <!-- Logo estilo Google -->
      <div class="flex items-center justify-center mb-4">
        <div class="rounded-full bg-gradient-to-r from-blue-500 to-teal-400 p-2">
          <svg class="w-10 h-10 text-white" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M44 20H24v8h11.4C33.4 30.9 29 35 23.5 35 16.6 35 11 29.4 11 22.5S16.6 10 23.5 10c3.8 0 7 1.4 9.5 3.7L38.6 8C34.2 4 28.1 2 23.5 2 10.5 2 0 12.5 0 25.5S10.5 49 23.5 49C36.5 49 47 38.5 47 25.5 47 24.6 46.9 23.7 46.8 22.9L44 20z" fill="white"/>
          </svg>
        </div>
      </div>
      <h1 class="text-2xl font-semibold">Inicia sesión en Example {{ hol }}</h1>
      <p class="text-sm text-gray-500 mt-1">Usa tu cuenta para continuar con la autorización</p>
    </header>

    <!-- Hidden OAuth params (que el backend o el query string deben proveer) -->
    <form id="loginForm" class="space-y-4">
      <input type="hidden" name="client_id" id="client_id" value="{{client_id}}">
      <input type="hidden" name="redirect_uri" id="redirect_uri">
      <input type="hidden" name="scope" id="scope">
      <input type="hidden" name="state" id="state">
      <input type="hidden" name="response_type" id="response_type">

      <div>
        <label class="block text-sm font-medium text-gray-700">Correo electrónico</label>
        <input id="email" name="email" type="text" required
               class="mt-1 block w-full rounded-md border-gray-200 shadow-sm focus:ring-2 focus:ring-blue-400 p-2" placeholder="tu@ejemplo.com">
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700">Contraseña</label>
        <input id="password" name="password" type="password" required
               class="mt-1 block w-full rounded-md border-gray-200 shadow-sm focus:ring-2 focus:ring-blue-400 p-2" placeholder="••••••••">
      </div>

      <div class="flex items-center justify-between text-sm">
        <label class="flex items-center gap-2">
          <input type="checkbox" id="remember" class="h-4 w-4 rounded">
          <span class="text-gray-600">Mantener sesión</span>
        </label>
        <a href="#" class="text-blue-600 hover:underline">¿Olvidaste tu contraseña?</a>
      </div>

      <div>
        <button type="submit" class="w-full py-2 rounded-md bg-blue-600 text-white font-medium hover:bg-blue-700">
          Iniciar sesión
        </button>
      </div>

      <div class="text-center text-sm text-gray-500">
        <p>¿No tienes cuenta? <a href="#" class="text-blue-600 hover:underline">Crear cuenta</a></p>
      </div>

      <div id="error" class="hidden text-red-600 text-sm mt-2"></div>
    </form>
  </main>

  <script>
    // Inicialización: tomamos parámetros OAuth desde querystring (si vienen)
    function qs(name) {
      const params = new URLSearchParams(location.search);
      return params.get(name) || '';
    }
   
    //document.getElementById('client_id').value = qs('client_id');
    document.getElementById('redirect_uri').value = qs('redirect_uri');
    document.getElementById('scope').value = qs('scope');
    document.getElementById('state').value = qs('state');
    document.getElementById('response_type').value = qs('response_type') || 'code';

    const form = document.getElementById('loginForm');
    const errorEl = document.getElementById('error');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.classList.add('hidden');
      const payload = {
        client_id: document.getElementById('client_id').value,
        redirect_uri: document.getElementById('redirect_uri').value,
        scope: document.getElementById('scope').value,
        state: document.getElementById('state').value,
        response_type: document.getElementById('response_type').value,
        username: document.getElementById('email').value,
        password: document.getElementById('password').value,
        remember: document.getElementById('remember').checked,
        grant_type: 'password'
      };

      try {
        // Ajusta la URL del backend a la tuya:
        const res = await fetch('auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(payload),
          credentials: 'include' // si usas cookies
        });

        const data = await res.json();

        if (!res.ok) {
          errorEl.textContent = data?.error || 'Error en autenticación';
          errorEl.classList.remove('hidden');
          return;
        }
       
        if (data.ok) {
          location.href = qs('returnUrl');
          return;
        }

        // Backend puede devolver:
        // 1) { redirect: 'https://client/cb?code=...' }  -> redirigir
        // 2) { next: 'consent', params: { ... } } -> abrir consent page
        if (data.redirect) {
          location.href = data.redirect;
          return;
        }

        if (data.next === 'consent') {
          // redirigir a consent page del servidor (backend puede generar URL)
          // si tu flow usa una página estática en frontend, se puede construir querystring
          const params = new URLSearchParams({
            client_id: payload.client_id,
            redirect_uri: payload.redirect_uri,
            scope: payload.scope,
            state: payload.state
          });
          location.href = '/consent.html?' + params.toString();
          return;
        }

        // Fallback: backend devuelve code y state
        if (data.code) {
          const redirectUri = payload.redirect_uri || '/';
          const url = new URL(redirectUri);
          url.searchParams.set('code', data.code);
          if (payload.state) url.searchParams.set('state', payload.state);
          location.href = url.toString();
          return;
        }

        errorEl.textContent = 'Respuesta inesperada del servidor';
        errorEl.classList.remove('hidden');

      } catch (err) {
        console.error(err);
        errorEl.textContent = 'No se pudo conectar con el servidor';
        errorEl.classList.remove('hidden');
      }
    });
  </script>
</body>
</html>
